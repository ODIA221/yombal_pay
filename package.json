{
  "name": "yombalpay",
  "version": "0.1.0",
  "description": "Passerelle de paiement Bitcoin Lightning pour les marchands du Sénégal, prix en FCFA, propulsée par Bitnob.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --quiet --watch src --watch public --watch .env --ext js,html,env src/server.js",
    "check:bitnob": "node scripts/check-bitnob.js",
    "invoice": "node scripts/create-invoice.js",
    "tunnel": "$HOME/.local/bin/cloudflared tunnel --url http://localhost:3000",
    "check:db": "node scripts/check-db.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "nodemailer": "^6.9.16",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
