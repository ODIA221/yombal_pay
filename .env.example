# Port du serveur Express
PORT=3000

# Identifiants Bitnob (tableau de bord Bitnob > Développeurs)
BITNOB_CLIENT_ID=
BITNOB_CLIENT_SECRET=

# Hôte de l'API Bitnob.
# Doc actuelle : https://api.bitnob.com (le secret choisit sandbox ou production)
# Guide de l'atelier : https://sandboxapi.bitnob.co
BITNOB_BASE_URL=https://api.bitnob.com

# Méthode de signature HMAC-SHA256 :
#   v2       -> CLIENT_ID:TIMESTAMP:NONCE:BODY, timestamp en secondes (doc actuelle)
#   workshop -> METHOD + PATH + TIMESTAMP + NONCE + BODY, timestamp en millisecondes (guide de l'atelier)
BITNOB_SIGNING=v2

# Taux de secours si le taux en direct est indisponible : prix d'1 BTC en FCFA
BTC_XOF_FALLBACK=60000000

# Clé secrète YombalPay donnée au site marchand (Authorization: Bearer ...)
# Générez-en une : node -e "console.log('sk_test_'+require('crypto').randomBytes(18).toString('hex'))"
YOMBAL_SECRET_KEY=

# Nom affiché sur la page de paiement
MERCHANT_NAME=Boutique de démo

# Secret des webhooks Bitnob (tableau de bord Bitnob > Webhooks)
BITNOB_WEBHOOK_SECRET=

# Secret qui signe les webhooks envoyés aux sites marchands (en-tête Yombal-Signature)
# Générez-en un : node -e "console.log('whsec_'+require('crypto').randomBytes(24).toString('hex'))"
YOMBAL_WEBHOOK_SECRET=

# Mode test : affiche « Simuler le paiement » sur les factures testnet (jamais en production)
YOMBAL_TEST_HELPERS=false

# Mot de passe du tableau de bord marchand (/dashboard, identifiant : marchand)
DASHBOARD_PASSWORD=

# Supabase (Project Settings > API) : URL du projet et clé secrète service_role.
# La clé service_role reste côté serveur, jamais dans le navigateur.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Secret qui signe les cookies de session des marchands
# Générez-en un : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Connexion avec Google (console.cloud.google.com > API et services > Identifiants > ID client OAuth, type « Application Web »)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Envoi des emails (Gmail : mot de passe d'application, myaccount.google.com/apppasswords)
# Laissez vide en développement : les emails s'affichent alors dans le terminal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Emails des administrateurs YombalPay (séparés par des virgules) : accès à /admin
ADMIN_EMAILS=

# Clé Bitnob de PRODUCTION (paiements réels). Vide = le mode production reste fermé.
# Le Client ID est le même qu'en sandbox ; seul le secret change.
BITNOB_LIVE_CLIENT_SECRET=
