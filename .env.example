# ── YombalPay — copiez ce fichier en .env à la racine du projet ──────────────

# URL publique de la passerelle (votre tunnel cloudflared / ngrok pendant la démo).
# Sert aux liens de paiement et au domaine de l'adresse Lightning (identifiant@domaine).
PUBLIC_URL=http://localhost:3000
PORT=3000

# ── Base de données : Supabase (PostgreSQL) ──────────────────────────────────
# Supabase → Project Settings → Database → Connection string → « Session pooler » (port 5432)
# Le schéma est créé automatiquement au démarrage, avec RLS activé sur toutes les tables.
# DATABASE_URL=postgresql://postgres.<ref-projet>:<mot-de-passe>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Facultatif : vérifier le certificat Supabase (Database → SSL Configuration → Download certificate)
# DATABASE_SSL_CA=./prod-ca-2021.crt
#
# Sans DATABASE_URL : PostgreSQL local (postgres://localhost:5432/yombal_pay), créé par ./run.sh

# ── Bitnob (dashboard Bitnob → Settings → API Keys) ──────────────────────────
# Sans clés, YombalPay démarre en MODE DÉMO (factures simulées + bouton « Simuler le paiement »).
BITNOB_CLIENT_ID=
BITNOB_CLIENT_SECRET=
# Secret de signature des webhooks Bitnob (HMAC-SHA512, en-tête x-bitnob-signature)
BITNOB_WEBHOOK_SECRET=
# BITNOB_BASE_URL=https://api.bitnob.com

# Forcer le mode démo même avec des clés (ex. réseau instable dans la salle)
# DEMO_MODE=true

# ── Retraits mobile money (payouts Bitnob) ───────────────────────────────────
# auto = simulé en démo, Bitnob en réel. Mettre « simulated » si le corridor SN n'est pas ouvert sur le compte.
PAYOUT_MODE=auto
# PAYOUT_COUNTRY=SN
# PAYOUT_CURRENCY=XOF
# PAYOUT_DAILY_MAX_XOF=2000000

# ── Taux et commission ───────────────────────────────────────────────────────
# 1 USD (≈ 1 USDT) en FCFA, et taux fixe de secours (1 BTC en FCFA)
USD_XOF=600
FIXED_XOF_PER_BTC=62000000
# RATE_PUBLIC_FALLBACK=false   # désactiver le repli CoinGecko
# Commission YombalPay en points de base (100 = 1 %)
YOMBALPAY_FEE_BPS=100

# Durée de validité de la facture / garantie du taux (secondes)
INVOICE_EXPIRY_SECONDS=900

# ── Marchand de démo « Wax & Co Dakar » ──────────────────────────────────────
# Identifiants de connexion du compte démo (gardez-les ici, jamais dans le code).
# Sans mot de passe, un mot de passe aléatoire est généré et affiché au premier démarrage.
DEMO_MERCHANT_EMAIL=
DEMO_MERCHANT_PASSWORD=
# SEED_DEMO=false   # ne pas créer le compte de démo
DEMO_MERCHANT_WEBHOOK_URL=http://localhost:4000/webhooks/yombalpay

# ── Boutique de démo ─────────────────────────────────────────────────────────
SHOP_PORT=4000
SHOP_URL=http://localhost:4000
YOMBALPAY_URL=http://localhost:3000

# ── Production ───────────────────────────────────────────────────────────────
# NODE_ENV=production   # webhooks marchands HTTPS publics uniquement, messages d'erreur génériques
